        \divide\dimen@\tw@
        \advance\dimen@\maxrwidth@
        \advance\dimen@-\rwidth@
        \ifdim\dimen@<\tw@\wdz@
            \llap{\vtop{\@movetag\normalbaselines\null\boxz@}}%%*T
        \else
            \llap{\boxz@}%
        \fi
        \tabskip\z@skip
