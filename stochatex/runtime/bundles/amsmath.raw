    \math@cr@@@
  \else
    \crcr
  \fi
  \egroup
  \restorecolumn@
  \egroup
}
\newcommand{\aligned@a}[1][c]{\start@aligned{#1}\m@ne}
\newenvironment{alignedat}{%
