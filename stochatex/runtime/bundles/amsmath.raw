\chardef\dspbrk@context=\sixt@@n
\def\dspbrk@[#1]{%
  \ifmeasuring@
  \else
    \ifcase\dspbrk@context % case 0 --- OK
      \global\dspbrk@lvl #1\relax
    \or                    % case 1 --- inside a box
      \nogood@displaybreak
    \else                  % other cases --- outside of a display
      \@amsmath@err{\Invalid@@\displaybreak}\@eha
