    \parindent1em
  \or
    \luatexkoclassicattr=5\relax
    \parindent1em
  \or
    \luatexkoclassicattr\@ne
    \parindent2em
  \or
    \luatexkoclassicattr=4\relax
    \parindent2em
  \else
    \luatexkoclassicattr\@ne
    \parindent1em
  \fi
  }
