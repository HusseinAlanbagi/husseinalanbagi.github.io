  \tag_mc_begin_pop:n{}
}
\socket_assign_plug:nn{tagsupport/luatexko/markoverwith/begin}{underline}
\socket_assign_plug:nn{tagsupport/luatexko/markoverwith/end}{common}
\cs_set_eq:NN \luatexko_markoverwith_original:nn \luatexkomarkoverwith
\RenewDocumentCommand\luatexkomarkoverwith{ m m }
{
  \tag_socket_use:n{luatexko/markoverwith/begin}
  \luatexko_markoverwith_original:nn
  {
    \tag_socket_use:n{luatexko/artifact/begin}
    \tag_suspend:n\markoverwith
    #1
    \tag_resume:n\markoverwith
    \tag_socket_use:n{luatexko/artifact/end}
  }
  {
    #2
  }
  \tag_socket_use:n{luatexko/markoverwith/end}
}
\AddToHook{cmd/uuline/before}
{
  \begingroup
  \socket_assign_plug:nn{tagsupport/luatexko/markoverwith/begin}{doubleunderline}
  \socket_assign_plug:nn{tagsupport/luatexko/markoverwith/end}{doubleunderline}
  \AddToHookNext{cmd/luatexkomarkoverwith/after}{\endgroup}
}
\AddToHook{cmd/sout/before}
{
  \begingroup
  \socket_assign_plug:nn{tagsupport/luatexko/markoverwith/begin}{strikeout}
  \AddToHookNext{cmd/luatexkomarkoverwith/after}{\endgroup}
}
\AddToHook{cmd/xout/before}
{
  \begingroup
  \socket_assign_plug:nn{tagsupport/luatexko/markoverwith/begin}{strikeout}
  \AddToHookNext{cmd/luatexkomarkoverwith/after}{\endgroup}
}
