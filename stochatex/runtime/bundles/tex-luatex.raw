\newbox\barracudabox
\newcommand\barracuda[3][_brcdempty_=true]{\directlua{
    local barracuda = require "barracuda"
    local enc_name = [[#2]]
    local data = [[#3]]
    local opt = {#1};
    if opt._brcdempty_ == true then
        barracuda:hbox(enc_name, data, "barracudabox")
    else
        barracuda:hbox(enc_name, data, "barracudabox", opt)
    end
}%
