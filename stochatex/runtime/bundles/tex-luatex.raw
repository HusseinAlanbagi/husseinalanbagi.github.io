}
% vertical environment
\tagpdfsetup{
  role/new-tag = Vertical/Div,
  role/new-tag = Horizontal/Div,
  role/new-attribute = {WritingMode-TbRl}{/O~/Layout~/WritingMode~(TbRl)},
  role/new-attribute = {WritingMode-LrTb}{/O~/Layout~/WritingMode~(LrTb)},
}
\socket_new:nn{tagsupport/luatexko/writingmode/begin}{1}
\socket_new:nn{tagsupport/luatexko/writingmode/end}{0}
\socket_new_plug:nnn{tagsupport/luatexko/writingmode/begin}{inline}
{
  \tag_mc_end_push:
  \tag_struct_begin:n{tag=Span, attribute=WritingMode-#1}
  \tag_mc_begin:n{}
}
\socket_new_plug:nnn{tagsupport/luatexko/writingmode/end}{inline}
{
  \tag_mc_end:
  \tag_struct_end:
  \tag_mc_begin_pop:n{}
}
\socket_new_plug:nnn{tagsupport/luatexko/writingmode/begin}{block}
{
  \tag_mc_end_push:
  \str_if_eq:nnTF {#1} {TbRl}
    { \tag_struct_begin:n{tag=Vertical, attribute=WritingMode-#1} }
    { \tag_struct_begin:n{tag=Horizontal, attribute=WritingMode-#1} }
}
\socket_new_plug:nnn{tagsupport/luatexko/writingmode/end}{block}
{
  \tag_struct_end:
  \tag_mc_begin_pop:n{}
}
\socket_assign_plug:nn{tagsupport/luatexko/writingmode/begin}{block}
\socket_assign_plug:nn{tagsupport/luatexko/writingmode/end}{block}
\socket_new_plug:nnn{tagsupport/minipage/before}{luatexko/vertical}
{
  \tag_mc_end_push:
  \bool_if:NT \l__tag_para_bool {\tag_struct_end:}
  \tag_struct_begin:n{tag=Vertical, attribute=WritingMode-TbRl}
}
\socket_new_plug:nnn{tagsupport/minipage/before}{luatexko/horizontal}
{
  \tag_mc_end_push:
  \bool_if:NT \l__tag_para_bool {\tag_struct_end:}
  \tag_struct_begin:n{tag=Horizontal, attribute=WritingMode-LrTb}
}
\RenewDocumentEnvironment{vertical}{m}
{
