---\font\fivett=cmtt10 at5pt
---\textfont\ttfam=\tentt
---\scriptfont\ttfam=\seventt
---\scriptscriptfont\ttfam=\fivett
---\def\tt{\fam=\ttfam \tentt}
---```sevensy
---\scriptscriptfont2=\fivesy
---\def\cal{\fam=2}
