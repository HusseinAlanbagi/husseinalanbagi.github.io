   local suffix=file.suffix(filename)
   local suffixes=suffix=="" and os.binsuffixes or { suffix }
   for directory in gmatch(os.getenv("PATH"),"[^"..io.pathseparator.."]+") do
    local df=file.join(directory,filename)
    for i=1,#suffixes do
