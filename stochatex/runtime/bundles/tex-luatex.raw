\cs_set_eq:NN \luatexko_ruby_original:nn \ruby
\RenewDocumentCommand\ruby{ m m }
{
  \tag_socket_use:n{luatexko/ruby/begin}
  \luatexko_ruby_original:nn
  {
    \tag_socket_use:nn{luatexko/ruby/text/begin}{RB}
    #1
    \tag_socket_use:n{luatexko/ruby/text/end}
  }
  {
    \tag_socket_use:nn{luatexko/ruby/text/begin}{RT}
