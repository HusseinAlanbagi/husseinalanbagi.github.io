     -- },
        ['quoteleft'] = {
            { 'quoteleft', 'quotedblleft' }
        },
        ['quoteright'] = {
            { 'quoteright', 'quotedblright' }
        },
        ['hyphen'] = {
            { 'hyphen', 'endash' }
        },
        ['endash'] = {
