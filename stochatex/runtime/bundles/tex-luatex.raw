---```lua
---local function to_hex(str)
---  return (str:gsub('.', function (c)
---      return string.format('%02x', string.byte(c))
---  end))
---end
---
---print(to_hex(sha2.digest512('test')))
--- -- ee26b0dd ... (length 128)
---```
