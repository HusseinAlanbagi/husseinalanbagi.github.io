                }%
     \fi
    }

\def \et@xl@ad #1#2,#3\endl@ad %%% the #1#2 code avoids spurious leading spaces
    {\et@xl@@d #1#2 \endl@ad
     \if *#3*
        \let \n@xt=\relax
     \else
