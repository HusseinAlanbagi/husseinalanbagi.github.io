% a slightly smaller unary minus
\def\unaryminus{\mathord{\mathpalette\unaryminus:make{}}}
\def\unaryminus:make#1#2{%
    \setbox0 = \hbox{$#1-$}
    \kern .75\wd0
    \pdfextension save
    \pdfextension setmatrix{.75 0 0 1} 
    \kern -\wd0 \box0
    \pdfextension restore}

