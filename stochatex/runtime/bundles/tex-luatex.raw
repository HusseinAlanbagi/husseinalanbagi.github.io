  if month<1 then
   month=1
  elseif month>12 then
   month=12
  end
  if day<1 then
   day=1
  else
   local max=nofdays(year,month)
   if day>max then
    day=max
   end
  end
  return year,month,day
 end
 function os.date(fmt,...)
  if not fmt then
   fmt="%Y-%m-%d %H:%M"
  end
  return date(fmt,...)
 end
end
do
