\NewDocumentCommand{\KKran}{ O{2pt} m O{} }{%
  \begingroup%
    % ç¬¬3å¼•æ•°(#3)ã®ã‚­ãƒ¼è¨­å®šã‚’é©ç”¨
      \pgfkeys{/KKran/.cd, #3}%

    % æç”»å†…å®¹ã‚’ãƒžã‚¯ãƒ­ã¨ã—ã¦å®šç¾©ï¼ˆï¼“å›žä½¿ã„å›žã™ï¼‰
    \def\byouga@KKran{%
      #2%
    }
    \begin{tikzpicture}
      % 1. é»’ã®å¤ªç·šã‚·ãƒ«ã‚¨ãƒƒãƒˆï¼ˆèƒŒæ™¯ï¼‰
      %    BlockFillModeã§ã‚³ãƒžãƒ³ãƒ‰ã‚’ã€Œå¡—ã‚Šã¤ã¶ã—ã€ã«å¤‰ãˆã€ã‚«ã‚¦ãƒ³ã‚¿ãƒ¼ã‚’ãƒªã‚»ãƒƒãƒˆã—ã¦ã‹ã‚‰æç”»
      \begin{scope}[line width=#1, line join=round] 
        \BlockFillMode@KKran
        % fillã ã‘ã§ãªãdrawã‚‚è¡Œã†ã“ã¨ã§å¤–å´ã«å¤ªã‚‰ã›ã‚‹
        \tikzset{every path/.style={draw=black, fill=black}} 
        \byouga@KKran
      \end{scope}

      % 2. ç™½ã®ã‚·ãƒ«ã‚¨ãƒƒãƒˆï¼ˆä¸­æŠœãç”¨ï¼‰
      %    ç·šã®å¤ªã•ã‚’0ã«ã—ã¦ã€ç´”ç²‹ãªå½¢çŠ¶ã ã‘ã§é»’ã„å¡Šã®å†…å´ã‚’ãã‚ŠæŠœã
      \begin{scope}
        \BlockFillMode@KKran
        \tikzset{every path/.style={fill=white, draw=none}}
        \byouga@KKran
      \end{scope}

      % 3. æœ¬ç•ªã®æç”»ï¼ˆå‰é¢ï¼‰
      \begin{scope}
        \byouga@KKran
      \end{scope}
    \end{tikzpicture}
  \endgroup%
  \def\how@to@count@shoumon@bangou{\kakko{\number\NUM@shoumon}}%
  \def\how@to@count@daimon@bangou{\kakko{\number\NUM@mondai}}%
}
