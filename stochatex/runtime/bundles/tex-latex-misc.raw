          {
           \prg_return_true:
          }
          {
           \prg_return_false:
          }
       }
   \prg_new_eq_conditional:NNn
     \pdfmanagement_get_documentproperties:nN
     \pdfmanagement_get_documentproperty:nN
     { T , F , TF }
    \msg_new:nnn  { pdfmanagement } { show-properties }
      {
