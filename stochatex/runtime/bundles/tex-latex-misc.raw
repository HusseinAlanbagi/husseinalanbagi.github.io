\begin{luacode*}
  stored_arrays = {}

  function register_mark_array(name, input_str)
    local items = {}
    -- åŒºåˆ‡ã‚Šã§è¦ç´ ã‚’å–å¾—ã—ã¦Luaãƒ†ãƒ¼ãƒ–ãƒ«ã«ä¿å­˜
    for s in string.gmatch(input_str, "[^|]+") do
        table.insert(items, s)
    end
    stored_arrays[name] = items
    
    -- TeXãƒžã‚¯ãƒ­ã‚’å®šç¾©
    -- \è§£ç­”ãƒžãƒ¼ã‚¯é…åˆ—[n] ã®å½¢å¼ã§å‘¼ã³å‡ºã›ã‚‹ã‚ˆã†ã«ã™ã‚‹ (ãƒ‡ãƒ•ã‚©ãƒ«ãƒˆã¯0)
    -- å†…éƒ¨ã§ render_mark_array ã‚’å‘¼ã³å‡ºã™
    tex.print("\\expandafter\\newcommand\\csname " .. name .. "ãƒžãƒ¼ã‚¯é…åˆ—\\endcsname[1][0]{" .. 
              "\\directlua{render_mark_array('" .. name .. "', #1)}}")
  end

  function render_mark_array(name, active_index)
    local items = stored_arrays[name]
    local output = {}
    local target = tonumber(active_index)

    for i, val in ipairs(items) do
        if i == target then
            -- æŒ‡å®šã•ã‚ŒãŸã‚¤ãƒ³ãƒ‡ãƒƒã‚¯ã‚¹ãªã‚‰é»’ä¸¸
            table.insert(output, "\\kyouteovalblackUSEINTERNAL{" .. val .. "}")
        else
            -- ãã‚Œä»¥å¤–ã¯ç™½ä¸¸
            table.insert(output, "\\jegg{" .. val .. "}")
        end
    end
    
    tex.print(table.concat(output, "\\hfill "))
  end
\end{luacode*}

%%% é…åˆ—ä½œæˆãƒžã‚¯ãƒ­
\newcommand{\MarkArrayMake}[2]{%
  \directlua{register_mark_array("\luaescapestring{#1}", "\luaescapestring{#2}")}%
}

%%% ãƒžãƒ¼ã‚¯ã‚·ãƒ¼ãƒˆè¡¨ç¤ºãƒžã‚¯ãƒ­
% -- ç¬¬3å¼•æ•°(ã‚ªãƒ—ã‚·ãƒ§ãƒ³)ãŒã‚ã‚Œã°ã€å†…éƒ¨ã®ãƒžã‚¯ãƒ­(#2)ã«ãã®å¼•æ•°ã‚’æ¸¡ã™ã€‚
% -- \MarkArrayMake{è§£ç­”}{|ã‚¢|ã‚¤|ã‚¦|ã‚¨|ã‚ª|}ã§é…åˆ—ä½œæˆã€‚
% -- \å°å•æ¬„{6}{1}[center={\ãƒžãƒ¼ã‚¯ã‚·ãƒ¼ãƒˆ{5}{\è§£ç­”ãƒžãƒ¼ã‚¯é…åˆ—}}]ã®ã‚ˆã†ã«ä½¿ç”¨ã€‚
\NewDocumentCommand{\ãƒžãƒ¼ã‚¯ã‚·ãƒ¼ãƒˆ}{ m m o }{%
  \makebox[#1\unit@KKran]{%
    \usefont{T1}{phv}{m}{n}\gtfamily%
    \IfNoValueTF{#3}{%
      #2% å¼•æ•°ãªã—ï¼ˆã™ã¹ã¦ç™½ï¼‰
    }{%
      #2[#3]% å¼•æ•°ã‚ã‚Šï¼ˆæŒ‡å®šç®‡æ‰€ã‚’é»’ãï¼‰
    }%
  }%
}
%%%

%%%% ãƒžã‚¹ç›®ç”¨ç¸®å°
\NewDocumentCommand{\å…¨è§’å¹…å›ºå®š}{ s m }{%
  \makebox[1\zw]{%
    \sbox0{#2}%
    \ifdim\wd0>1\zw%
      \resizebox{1\zw}{\height}{\usebox0}%
    \else%
      \usebox0%
    \fi%
  }%
}
