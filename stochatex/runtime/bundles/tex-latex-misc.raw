         {
           \bool_if:NT \l_pdfoutline_active_bool
             {\__pdfoutline_item:nnnn {##1}{##2}{##3}{action}}
         }
     }
  }
\cs_generate_variant:Nn \pdfoutline_action:nnn {nee}
