\keys_define:nn { hyp }
 {
   ,baseurl       .code:n =
     {
       \__hyp_text_pdfstring:noN  { #1 } {\l__hyp_text_enc_uri_print_tl} \l__hyp_tmpa_tl
        \tl_if_empty:NTF \l__hyp_tmpa_tl
          {
