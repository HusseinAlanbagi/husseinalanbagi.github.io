                     Check~if~the~standard~must~be~changed~to~PDF/A-4F
                   }
                }
                {
                  \msg_warning:nne { pdf } { validation-failure }
                   {
                     Embedded~non-PDF~files~detected.\iow_newline:
                     This~is~not~allowed~in~standard~\l__pdfmeta_tmpa_tl
                   }
                }
             }
          }
      }
 }
