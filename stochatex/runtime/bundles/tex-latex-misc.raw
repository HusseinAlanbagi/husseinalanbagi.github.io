\tl_const:Ne\c__tag_check_pdfversion_tl {\pdf_version:}
\AddToHook{begindocument/before}
  {
    \tl_if_eq:eeF{\c__tag_check_pdfversion_tl}{\pdf_version:}
      {
        \msg_error:nnee {tag}{wrong-pdfversion}{\c__tag_check_pdfversion_tl}{\pdf_version:}
        \pdf_version_gset:e {\c__tag_check_pdfversion_tl}
        \pdf_object_unnamed_write:nn{dict}{}
      }
  }
