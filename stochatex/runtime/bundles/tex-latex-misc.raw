        % get the previous one, shouldn't be empty as the root should be there
        \seq_get:NNTF \g__tag_struct_stack_seq \l__tag_tmpa_tl
          {
            \tl_gset:No  \g__tag_struct_stack_current_tl { \l__tag_tmpa_tl }
