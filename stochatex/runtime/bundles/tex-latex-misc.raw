   3 = 1   , %StructTreeRoot, not really needed
   4 = [a] , %ruby
   5 = [b] , %warichu
   6 = c   , % WP ??
   7 = â€¡   , % Part,Div,NonStruct -> "check parent"
   8 = âˆ…*  , % or negative by default?
  -1 = âˆ… ,
 }
