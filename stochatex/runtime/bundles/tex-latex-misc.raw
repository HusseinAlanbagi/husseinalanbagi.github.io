\cs_generate_variant:Nn\pdf_version_gset:n{e}
\cs_new_protected:Nn\__pdfmeta_force_standard_pdfversion:
 {
   \pdfmeta_standard_verify:nnF { min_pdf_version }
    { \pdf_version: }
    {
      \pdfmeta_standard_verify:nTF { max_pdf_version }
       {
         \pdf_version_gset:n { 2.0 }
       }
       {
         \pdf_version_gset:e{ \pdfmeta_standard_item:n{ max_pdf_version } }
       }
    }
  \pdfmeta_standard_verify:nnF { max_pdf_version }
    { \pdf_version: }
    {
      \pdf_version_gset:e{ \pdfmeta_standard_item:n{ max_pdf_version } }
    }
 }
\cs_new_protected:Npn \__pdfmeta_check_standard_pdfversion:
 {
   \clist_map_inline:nn{A,UA,X}
    {
     \pdfmeta_standard_family:nn { ##1 }
      {
        \pdfmeta_standard_verify:nnF { min_pdf_version }
          { \pdf_version: }
          { \msg_warning:nneee {pdf}{wrong-pdfversion} %TODO make error
            {\pdf_version:}{low}
            {
             \pdfmeta_standard_item:n{name}
            }
          }
        \pdfmeta_standard_verify:nnF { max_pdf_version }
         { \pdf_version: }
         { \msg_warning:nneee {pdf}{wrong-pdfversion}
           {\pdf_version:}{high}
           {
            \pdfmeta_standard_item:n{name}
           }
         }
       }
    }
 }
