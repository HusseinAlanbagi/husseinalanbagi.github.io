  {\sl\uppercase{\refname}}{\sl\uppercase{\refname}}}\list
  {\relax}{\setlength{\labelsep}{0em}
  \setlength{\itemindent}{-4mm}
  \setlength{\leftmargin}{4mm}}
  \setlength{\parsep}{0pt}
