   \bool_if:NTF \l__hyp_href_url_encode_bool
    {
      \tl_set:Nn \l__hyp_text_enc_uri_print_tl {utf8/URI}
    }
    {
      \tl_set:Nn \l__hyp_text_enc_uri_print_tl {utf8/string}
    }
  \hyper@normalise\__hyp_href_url_aux:nn}

