          Equation line \the\row@\space is too large %
          by \the\dimen@\MessageBreak
          in environment `\@currenvir'%
        }%
      \endgroup
      \setboxz@h to\dimen@{%
        \resizebox{\dimen@}{!}{\boxz@}%
        \hss
      }%
    \fi
  \fi
}
