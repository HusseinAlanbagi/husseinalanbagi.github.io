\cs_new_protected:Npn \__tag_struct_use_check_parent_child:nn #1 #2
  {
    \__tag_struct_get_role:enNN
      {#2}
      {rolemap}
      \l__tag_get_child_tmpa_tl
      \l__tag_get_child_tmpb_tl
    \str_case:onTF { \l__tag_get_child_tmpa_tl }
      {
        {Part} {}
        {Div}  {}
        {NonStruct} {}
      }
      { %child=Part etc
        \__tag_struct_get_role:enNN
         {#2}
         {parentrole}
         \l__tag_get_child_tmpa_tl
         \l__tag_get_child_tmpb_tl
        \str_if_eq:noTF
         {STASHED}{\l__tag_get_child_tmpa_tl}
         {
           % warn about unknown relationship
         }
         {
           % test if
           \__tag_struct_get_role:enNN
            {#1}
            {parentrole}
            \l__tag_get_parent_tmpa_tl
            \l__tag_get_parent_tmpb_tl
           \tl_if_eq:NNTF\l__tag_get_parent_tmpa_tl \l__tag_get_child_tmpa_tl
            {
              \__tag_struct_check_parent_child:nn {#1}{#2}
            }
            {
              %warn that parent-tag was misused.
            }
         }
      }
      {
        %child not Part etc, normal parent child test.
        \__tag_struct_check_parent_child:nn {#1}{#2}
      }
  }
