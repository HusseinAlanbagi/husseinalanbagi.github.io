%%% ãƒžãƒ¼ã‚¯ã‚·ãƒ¼ãƒˆ
\ifnum\number\kkran@kaitouhyouji=1 %
  \let\kyouteovalblackUSEINTERNAL\jegg@new@black%
\else%
