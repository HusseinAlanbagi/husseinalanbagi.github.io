 { \tl_set:Nn#2{#1} }
\AddToHook{class/article/after}[head/example]
 {
   \DeclareInstance{heading}{part}{display}
     {
      , name          = part
      , level         = -1
      , before-vspace = 4ex
      , after-vspace  = 3ex
      , mark-cmd     = \partmark {#1}
      , prefix        = \partname
      , number-format = \thepart
      , heading-decls = \raggedright\bfseries\Large
      , title-decls   = \huge
      , headformat-instance = part
     }
