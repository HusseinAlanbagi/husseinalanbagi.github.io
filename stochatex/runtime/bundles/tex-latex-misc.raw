    }
 }
\socket_if_exist:nF {tagsupport/link/before}
 {
   \NewTaggingSocket{link/before}{1}
   \NewTaggingSocket{link/after}{1}
 }
\NewTaggingSocketPlug{link/before}{kernel}
 {
   \mode_leave_vertical:
   \tag_mc_end_push:
