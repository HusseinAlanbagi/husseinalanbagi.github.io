                  {%
  \ifdim\stockwidth  > 0pt \else \stockwidth\paperwidth \fi
  \ifdim\stockheight > 0pt \else \stockheight\paperheight \fi
  \renewcommand*\CROP@genreflect[1]{%
    \leavevmode
    \dimen0\CROP@horigin
    \kern2\dimen0
