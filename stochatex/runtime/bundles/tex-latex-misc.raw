  {
   \tl_set:Ne \l__pdfmeta_xmp_doclang_tl  {\pdfmanagement_get_documentproperty:n{document/lang}}
   \tl_set:Ne \l__pdfmeta_xmp_metalang_tl {\pdfmanagement_get_documentproperty:n{hyperref/pdfmetalang}}
   \tl_if_blank:VT \l__pdfmeta_xmp_metalang_tl
    { \cs_set_eq:NN \l__pdfmeta_xmp_metalang_tl\l__pdfmeta_xmp_doclang_tl}
