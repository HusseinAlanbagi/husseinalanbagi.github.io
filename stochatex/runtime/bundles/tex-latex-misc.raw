      }
  }
\cs_new_protected:Npn \__pdfmeta_xmp_create_uuid:nN #1 #2
  {
    \str_set:Ne#2 {\str_lowercase:f{\tex_mdfivesum:D{#1}}}
    \str_set:Ne#2
      { uuid:
        \str_range:Nnn #2{1}{8}
        -\str_range:Nnn#2{9}{12}
        -4\str_range:Nnn#2{13}{15}
        -8\str_range:Nnn#2{16}{18}
        -\str_range:Nnn#2{19}{30}
      }
  }
