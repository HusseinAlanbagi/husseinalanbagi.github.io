   \tag_mc_begin:n {}
   #1
 }
\AssignTaggingSocketPlug{link/before}{kernel}

\NewTaggingSocketPlug{link/after}{kernel}
 {
   #1
   \tag_mc_end:
   \tag_struct_end:
   \tag_mc_begin_pop:n{}
 }
\AssignTaggingSocketPlug{link/after}{kernel}

