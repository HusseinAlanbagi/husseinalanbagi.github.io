{
  name                = macrocode,
  tag-name            = \UseStructureName{block/verbatim},
  tag-attr-class      = ,
  tagging-recipe      = standard,
  inner-level-counter = ,
  transparent-level   = true,
  legacy-code         = ,
  block-instance      = verbatim ,
  inner-instance      = ,
  final-code          = \legacymacrocodesetup ,
  para-instance       = justify,
  tagging-suppress-paras = true
}
\RenewDocumentEnvironment{macrocode}{!O{}}
  {\SimpleBlockEnv{macrocode}
      {begin-penalty = \predisplaypenalty,
       begin-vspace  = \MacrocodeTopsep,
       left-margin   = \MacroIndent,
       para-indent  =0pt,#1}
   \@setupverbinvisiblespace
   \init@crossref
   \frenchspacing \@vobeyspaces
   \xmacro@code
  }
  {
   \ifpm@module \endgroup \pm@modulefalse \fi
   \everypar{}
   \BlockEnvEnd
   \close@crossref
  }
\int_new:N\l__codedoc_nested_env_int
\long\def\@doc@env#1#2#3{
  \endgroup
  \int_incr:N\l__codedoc_nested_env_int
   \tagpdfsetup{role/new-tag=#2/Sect}
   \int_compare:nNnF{\l__codedoc_nested_env_int}>{1}
    {\SimpleBlockEnv{displayblock}
      {transparent-level=true,tag-name=#2,begin-vspace=\MacroTopsep}
    \tagstructbegin{tag=\UseStructureName{doc/macronames}}
    \tl_set:Ne \l__codedoc_current_names_struct_tl {\tag_get:n{struct_num}}
    \tagstructend
    }
  \clist_map_inline:nn {#3} { \@doc@env@{#1}{#2}{##1} }\ignorespaces
}
\long\def\@doc@env@#1#2#3{%
  \edef\saved@macroname{\string#3}%
    \if #1%
      \edef\saved@indexname{\expandafter\@gobble\saved@macroname}%
      \expandafter\ifx
                  \csname Code#2Index\endcsname
                  \CodeMacroIndex
      \else
        \record@index@type@save
          {\saved@indexname}{#2}%
      \fi
    \else
      \let\saved@indexname\saved@macroname
    \fi
    \def\makelabel##1{\noindent\llap{
      \UseTaggingSocket{inline/begin}
        {tag=\UseStructureName{doc/macroname},parent=\l__codedoc_current_names_struct_tl}
      ##1\hspace{\itemsep}
      \UseTaggingSocket{inline/end}
      }}%
      \let\@tempa\@empty
      \count@\macro@cnt
      \loop\ifnum\count@>\z@
        \edef\@tempa{\@tempa\hbox{\strut}}\advance\count@\m@ne
      \repeat
      \edef\makelabel##1{\noindent\llap{
      \UseTaggingSocket{inline/begin}
        {tag=\UseStructureName{doc/macroname},parent=\l__codedoc_current_names_struct_tl}
      \vtop to\baselineskip{\@tempa\hbox{##1\kern\labelsep}\vss}
      \UseTaggingSocket{inline/end}
      }}%
      \advance\macro@cnt\@ne
    \ifdoc@noprint
    \else
      \edef\@tempa{%
        \noexpand\makelabel{
        \noexpand\doc@providetarget
        \noexpand\strut
        \noexpand\@nameuse{Print#2Name}{\saved@macroname}}}%
      \@tempa
    \fi
    \ifdoc@noindex\else
      \global\advance\c@CodelineNo\@ne
      \csname SpecialMain#2Index\expandafter\endcsname
        \expandafter{\saved@macroname}\nobreak
      \global\advance\c@CodelineNo\m@ne
    \fi
    \if#1\expandafter\DoNotIndex \expandafter {\saved@macroname}\fi
    \ignorespaces}
\def\doc@createenv#1#2#3{%
  \@namedef{#3}{%
    \@ifnextchar[%]
    {\doc@env{#1}{#2}}{\doc@env{#1}{#2}[]}}%
  \@namedef{end#3}
   {
    \int_compare:nNnF{\l__codedoc_nested_env_int}>{1}{\BlockEnvEnd}
    \int_decr:N\l__codedoc_nested_env_int
   }%
  %\@namedef{end#3}{\BlockEnvEnd}%
}
