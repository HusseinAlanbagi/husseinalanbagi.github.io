       \seq_set_from_clist:Nn \l__pdffield_choice_displayvalues_seq {#1}
     }
   ,top-index .code:n =
     {
       \pdfdict_put:nne {l__pdffield/field}{TI}{\int_eval:n{#1-1}}
     }
  }
\cs_new_protected:Npn \__pdffield_choice_set_type: {}

\keys_define:nn { pdffield }
  {
    type .choice:
