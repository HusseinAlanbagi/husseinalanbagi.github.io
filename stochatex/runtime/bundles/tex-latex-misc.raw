\def\ltlabsecIIdate{2026-05-25}
\def\ltlabsecIIversion{0.9g}
\ProvidesExplPackage
 {latex-lab-testphase-sec-template}
 {\ltlabsecIIdate}
 {\ltlabsecIIversion}
 {heading implementation}
\bool_new:N \g__head_debug_bool
\cs_new_eq:NN \__head_debug:n \use_none:n
\cs_new_eq:NN \__head_debug_typeout:n \use_none:n
\cs_new_protected:Npn \head_debug_on:
  {
    \bool_gset_true:N \g__head_debug_bool
    \__head_debug_gset:
  }
\cs_new_protected:Npn \head_debug_off:
  {
    \bool_gset_false:N \g__head_debug_bool
    \__head_debug_gset:
  }
\cs_new_protected:Npn \__head_debug_gset:
  {
    \cs_gset_protected:Npe \__head_debug:n ##1
      { \bool_if:NT \g__head_debug_bool {##1} }
    \cs_gset_protected:Npe \__head_debug_typeout:n ##1
      { \bool_if:NT \g__head_debug_bool { \typeout{[head]~ ##1} } }
  }
\cs_new_protected:Npn \DebugHeadingsOn  { \head_debug_on:  }
\cs_new_protected:Npn \DebugHeadingsOff { \head_debug_off: }
\DebugHeadingsOff
\cs_new:Npn \__head_show_arguments:nnnnnn #1#2#3#4#5#6 {
  \__head_debug_typeout:n{---------~ Headformat~ instance~ arguments:}
  \__head_debug_typeout:n{1:~ keys~ =~ \exp_not:n{#1}}
  \__head_debug_typeout:n{2:~ prefix~ =~ \exp_not:n{#2}}
  \__head_debug_typeout:n{3:~ number~ =~ \exp_not:n{#2}}
  \__head_debug_typeout:n{4:~ title~ =~ \exp_not:n{#3}}
  \__head_debug_typeout:n{5:~ subtitle~ =~ \exp_not:n{#4}}
  \__head_debug_typeout:n{6:~ quotation~ =~ \exp_not:n{#5}}
}
\cs_new:Npn \__head_show_arguments:nnnnnnnnn #1#2#3#4#5#6#7#8#9 {
  \__head_debug_typeout:n{---------~ Heading~ instance~ arguments:}
  \__head_debug_typeout:n{1:~ keys~ =~ \exp_not:n{#1}}
  \__head_debug_typeout:n{2:~ unnumbered~ =~ \exp_not:n{#2}}
  \__head_debug_typeout:n{3:~ title~ =~ \exp_not:n{#3}}
  \__head_debug_typeout:n{4:~ toc~ =~ \exp_not:n{#4}}
  \__head_debug_typeout:n{5:~ running~ =~ \exp_not:n{#5}}
  \__head_debug_typeout:n{6:~ bookmark~ =~ \exp_not:n{#6}}
  \__head_debug_typeout:n{7:~ nameref~ =~ \exp_not:n{#7}}
  \__head_debug_typeout:n{8:~ label~ =~ \exp_not:n{#8}}
  \__head_debug_typeout:n{9:~ subtitle | quote ~ =~ \exp_not:n{#9}}
}
\tl_new:N\l__head_tmpa_tl
\tl_new:N\l__head_label_tl
\tl_new:N\l__head_instance_keys_tl
\tl_new:N\l__head_typeset_number_tl
\tl_new:N\l__head_saved_secnumdepth_tl
\tl_new:N \l__head_title_tl
\tl_new:N \l__head_placement_tl
\tl_new:N\theheading
\AddToHook{class/after}{\providecommand*\partmark[1]{\markboth{}{}}}
\cs_new_protected:Npn \ParseLaTeXeHeading #1 #2 #3 #4 {
  \__head_debug_typeout:n{==================================}
  \__head_debug_typeout:n{#1:~ \IfBooleanT{#2}{*}
                \IfValueT{#3}{[\exp_not:n{#3}]}
                {\exp_not:n{#4}}}
  \__head_find_label:w #4 \label\q_no_value \__head_find_label:w
  \IfBooleanTF{#2}
    {
      \tl_clear:N \l__head_toc_tl
      \tl_clear:N \l__head_running_tl
      \tl_clear:N \l__head_bookmark_tl
      \bool_set_true:N \l__head_unnumbered_bool
    }
    {
      \tl_set_eq:NN \l__head_toc_tl      \l__head_title_tl
      \tl_set_eq:NN \l__head_running_tl  \l__head_title_tl
      \tl_set_eq:NN \l__head_bookmark_tl \l__head_title_tl
      \bool_set_false:N \l__head_unnumbered_bool
    }
  \tl_set_eq:NN \l__head_nameref_tl \l__head_title_tl
  \tl_set_eq:NN \l__head_subtitle_tl \c_novalue_tl
  \tl_set_eq:NN \l__head_quote_tl    \c_novalue_tl
  \IfNoValueTF { #3 }
    { \tl_clear:N \l__head_instance_keys_tl }
    { \keys_set_known:nnN {heading} { #3 } \l__head_instance_keys_tl }
  \__head_debug_typeout:n{use~ 'heading'~ instance:~ #1 }
  \use:e {
    \exp_not:N \UseInstance{heading}{#1}
              { \exp_not:o \l__head_instance_keys_tl }
              { \bool_if:NTF \l__head_unnumbered_bool \BooleanTrue \BooleanFalse }
              { \exp_not:o \l__head_title_tl}
              { \exp_not:o \l__head_toc_tl }
              { \exp_not:o \l__head_running_tl }
              { \exp_not:o \l__head_bookmark_tl }
              { \exp_not:o \l__head_nameref_tl }
              { \exp_not:o \l__head_label_tl }
              { { \exp_not:o \l__head_subtitle_tl }
                { \exp_not:o \l__head_quote_tl    } }
  }
}
\keys_define:nn {heading} {
  , shorttitle .meta:n    =
      {toc = {#1} , running = {#1} , bookmark = {#1} , nameref= {#1} }
  , bookmark   .tl_set:N  = \l__head_bookmark_tl
  , running    .tl_set:N  = \l__head_running_tl
  , toc        .tl_set:N  = \l__head_toc_tl
  , nameref    .tl_set:N  = \l__head_nameref_tl
  , numbered   .bool_set_inverse:N = \l__head_unnumbered_bool
  , numbered   .default:n = true
  , unnumbered .bool_set:N = \l__head_unnumbered_bool
  , unnumbered .default:n = true
  , subtitle   .tl_set:N  = \l__head_subtitle_tl
  , quote      .tl_set:N  = \l__head_quote_tl
  , label      .code:n    = \tl_put_right:Nn \l__head_label_tl { \label{#1} }
}
\cs_new:Npn \__head_find_label:w #1 \label #2#3 \__head_find_label:w {
  \quark_if_no_value:nTF {#2}
     {
       \__head_debug_typeout:n{---~no~label }
       \tl_clear:N \l__head_label_tl
       \tl_set:Nn\l__head_title_tl {#1#3}
     }
     {
       \__head_debug_typeout:n{---~label~found~#2}
       \tl_set:Nn\l__head_label_tl { \label{#2} }
       \tl_set:Nn\l__head_title_tl {#1}
       \__head_find_label_aux:w #3\__head_find_label_aux:w
     }
     \__head_debug_typeout:n{---~return:~ '\exp_not:o \l__head_title_tl' }
}
\cs_new:Npn \__head_find_label_aux:w #1 \label #2#3 \__head_find_label_aux:w {
  \tl_put_right:Nn \l__head_title_tl { #1 }
  \quark_if_no_value:nF {#2}
    {
      \__head_debug_typeout:n{---~ extra~ label~ '#2'~ found }
      \tl_put_right:Nn \l__head_label_tl { \label{#2} }
      \__head_find_label_aux:w #3\__head_find_label_aux:w
    }
}
\NewTemplateType{heading}{9}
\NewTemplateType{headformat}{6}
\DeclareTemplateInterface{heading}{display}{9}
{
  , name          : tokenlist
  , parent-name   : tokenlist
  , reset-counter : tokenlist
  , level         : integer = 0
  , placement     : choice {page , top , normal } = normal
  , mark-cmd      : function(1) =
  %
  % many more keys for layout settings are missing for now
  , para-indent   : choice { true , false } = false
  , before-vspace : skip = 0pt
  , penalty       : integer = \c_max_int
  , after-penalty-vspace : skip = 0pt
  , after-vspace  : skip = 0pt
  , start-code    : tokenlist =      % no default values!
  , final-code    : tokenlist =      % no default values!
  , prefix         : tokenlist = \NoValue
  , heading-decls  : tokenlist = \normalfont
  , prefix-decls   : tokenlist =
  , number-decls   : tokenlist =
  , title-decls    : tokenlist =
  , subtitle-decls : tokenlist =
  , quote-decls    : tokenlist =
  , headformat-instance : tokenlist = std
  , number-format  : function(1) = \theheading
  , contents-extra : tokenlist =
}
\DeclareTemplateCopy{heading}{runin}{display}
\DeclareTemplateInterface{headformat}{display}{6}
{
  , heading-indent    : length = 0pt
  , title-format      : function(1) = #1
  , prefix-number-sep : tokenlist = \WordSpaceAmount{1}
  , number-title-sep  : tokenlist = 20pt
}
\DeclareTemplateInterface{headformat}{hang}{6}
{
  , heading-indent    : length = 0pt
  , title-format      : function(1) = #1
  , prefix-number-sep : tokenlist = \WordSpaceAmount{1}
  , number-title-sep  : tokenlist = 1em
}
\DeclareTemplateInterface{headformat}{runin}{6}
{
  , heading-indent    : length = 0pt
  , title-format      : function(1) = #1
  , prefix-number-sep : tokenlist = \WordSpaceAmount{1}
  , number-title-sep  : tokenlist = 1em
}
\DeclareTemplateCode{heading}{display}{9}
{
  , name          = \l__head_name_tl
  , level         = \l__head_level_int
  , parent-name   = \l__head_pname_tl
  , reset-counter = \l__head_reset_cnt_tl
  , placement     = {
        ,page   = \__head_debug_typeout:n{ A~ page~ heading }
                  \tl_set:Nn \l__head_placement_tl { page }
        ,top    = \__head_debug_typeout:n{ A~ top~ heading }
                  \tl_set:Nn \l__head_placement_tl { top }
        ,normal = \__head_debug_typeout:n{ A~ normal~ heading }
                  \tl_set:Nn \l__head_placement_tl { normal }
                    }
  , mark-cmd      = \__head_mark_cmd:n
  , para-indent   = {
                      ,true  = \@afterindenttrue
                      ,false = \@afterindentfalse
                    }
  , before-vspace = \l__head_before_skip
  , penalty       = \l__head_penalty_int
  , after-penalty-vspace  = \l__head_after_penalty_skip
  , after-vspace  = \l__head_after_skip
  , start-code    = \l__head_start_code_tl
  , final-code    = \l__head_final_code_tl
  , prefix        = \l__head_typeset_prefix_tl
  , headformat-instance = \l__head_headformat_instance_tl
  , heading-decls  = \l__head_heading_decls_tl
  , prefix-decls   = \l__head_prefix_decls_tl
  , number-decls   = \l__head_number_decls_tl
  , title-decls    = \l__head_title_decls_tl
  , subtitle-decls = \l__head_subtitle_decls_tl
  , quote-decls    = \l__head_quote_decls_tl
  , number-format  = \__head_number_format:n
  , contents-extra = \l__head_contents_extra_tl
}
{
  \tl_set_eq:Nc \theheading { the \l__head_name_tl }
  \tl_set:Ne\l__head_saved_secnumdepth_tl{\int_use:N\c@secnumdepth}
  \__head_show_arguments:nnnnnnnnn
       {#1}{#2}{#3}{#4}{#5}{#6}{#7}{#8}{#9}
  \tl_if_empty:oF {#1} { \SetTemplateKeys{heading}{display}{#1} }
  \tl_if_empty:oT \l__head_start_code_tl
   { \str_case:VnF \l__head_placement_tl
      {
        { page }
        { \tl_set:Nn \l__head_start_code_tl
            {
             \if@openright
               \cleardoublepage
             \else
               \clearpage
             \fi
             \thispagestyle{plain}%
             \if@twocolumn
               \onecolumn
               \@tempswatrue
             \else
               \@tempswafalse
             \fi
             \null\vfil
            }
        }
        { top }
        { \tl_set:Nn \l__head_start_code_tl
            {
              \if@openright\cleardoublepage\else\clearpage\fi
              \thispagestyle{plain}%
              \global\@topnum\z@
            }
        }
      }
      { \tl_clear:N \l__head_start_code_tl }
   }
  \tl_if_empty:oT \l__head_final_code_tl
   { \str_case:VnF \l__head_placement_tl
      {
        { page }
        { \tl_set:Nn \l__head_final_code_tl
            {
              \vfil\newpage
              \if@twoside
                \if@openright
                  \null
                  \thispagestyle{empty}%
                \newpage
                \fi
              \fi
              \if@tempswa
                \twocolumn
              \fi
            }
        }
      }
      { \tl_set:Nn  \l__head_final_code_tl { \@afterheading } }
   }
  \__head_determine_penalty:
  \__head_determine_number_typesetting:N #2
  \__head_vertical_before_spacing:
\UseTaggingSocket{sec/end}{\int_use:N\l__head_level_int}
\UseTaggingSocket{sec/begin}
  {{\int_use:N\l__head_level_int}{tag=\UseStructureName{sec/\int_use:N\l__head_level_int}}}
  \__head_debug_typeout:n{use~ 'headformat'~instance:~
                       \l__head_headformat_instance_tl }
  \use:e {
    \UseInstance{headformat} { \l__head_headformat_instance_tl }
                { \exp_not:o \UnusedTemplateKeys }
                { \exp_not:o { \l__head_typeset_prefix_tl } }
                { \exp_not:o { \l__head_typeset_number_tl } }
                { \exp_not:n { #3 } }
                { \exp_not:o { \use_i:nn  #9 } }
                { \exp_not:o { \use_ii:nn  #9 } }
  }
 %
  \__head_handle_marks_etc:nnnnn {#4}{#5}{#6}{#7}{#8}
  \int_gset:Nn\c@secnumdepth{\l__head_saved_secnumdepth_tl}
  \par \nobreak
  \skip_vertical:N \l__head_after_skip
  \l__head_final_code_tl
  \ignorespaces
}
\AddToHook{begindocument}{
  \ifcsname if@openright\endcsname
  \else
    \expandafter\newif\csname if@openright\endcsname
  \fi
}
\DeclareTemplateCode{heading}{runin}{9}
 {
  , name           = \l__head_name_tl
  , level          = \l__head_level_int
  , parent-name    = \l__head_pname_tl
  , reset-counter  = \l__head_reset_cnt_tl
  , placement      = {
         page   = \typeout{ ^^JA~ runin~ page~ placement~ heading~makes~no~sense
                            (top~used)}
                  \tl_set:Nn \l__head_placement_tl { top }
        ,top    = \__head_debug_typeout:n{ A~ top~ heading }
                  \tl_set:Nn \l__head_placement_tl { top }
        ,normal = \__head_debug_typeout:n{ A~ normal~ heading }
                  \tl_set:Nn \l__head_placement_tl { normal }
                    }
  , mark-cmd       = \__head_mark_cmd:n
  , para-indent    =  {
                       ,true  = %\typeout{para-indent~ setting~ ignored}
                       ,false = %\typeout{para-indent~ setting~ ignored}
                      }
  , before-vspace  = \l__head_before_skip
  , penalty        = \l__head_penalty_int
  , after-penalty-vspace  = \l__head_after_penalty_skip
  , after-vspace   = \l__head_after_skip
  , start-code     = \l__head_start_code_tl
  , final-code     = \l__head_final_code_tl
  , prefix        = \l__head_typeset_prefix_tl
  , headformat-instance = \l__head_headformat_instance_tl
  , heading-decls  = \l__head_heading_decls_tl
  , prefix-decls   = \l__head_prefix_decls_tl
  , number-decls   = \l__head_number_decls_tl
  , title-decls    = \l__head_title_decls_tl
  , subtitle-decls = \l__head_subtitle_decls_tl
  , quote-decls    = \l__head_quote_decls_tl
  , number-format  = \__head_number_format:n
  , contents-extra = \l__head_contents_extra_tl
}
{
  \__head_show_arguments:nnnnnnnnn
       {#1}{#2}{#3}{#4}{#5}{#6}{#7}{#8}{#9}
  \tl_set:Ne\l__head_saved_secnumdepth_tl{\int_use:N\c@secnumdepth}
  \tl_set_eq:Nc \theheading { the \l__head_name_tl }
  \tl_if_empty:oF {#1} { \SetTemplateKeys{heading}{runin}{#1} }
  \tl_if_empty:oT \l__head_start_code_tl
   {
    \str_case:Vn \l__head_placement_tl
      {
        { top }   { \tl_set:Nn \l__head_start_code_tl {\clearpage } }
      }
   }
  \__head_determine_penalty:
  \__head_determine_number_typesetting:N #2
  \__head_vertical_before_spacing:
  \UseTaggingSocket{sec/end}{\int_use:N\l__head_level_int}
  \UseTaggingSocket{sec/begin}
    {{\int_use:N\l__head_level_int}{tag=\UseStructureName{sec/\int_use:N\l__head_level_int}}}
  \UseTaggingSocket{sec/title/init}{\int_use:N\l__head_level_int}
  \def \@svsechd {
      \__head_debug_typeout:n{use~ 'headformat'~instance:~
                          \l__head_headformat_instance_tl }
      \use:e {
        \UseInstance{headformat} { \l__head_headformat_instance_tl }
                 { \exp_not:o \UnusedTemplateKeys }
                 { \exp_not:o { \l__head_typeset_prefix_tl } }
                 { \exp_not:o { \l__head_typeset_number_tl } }
                 { \exp_not:n { #3 } }
                 { \exp_not:o { \use_i:nn  #9 } }
                 { \exp_not:o { \use_ii:nn  #9 } }
      }
      \__head_handle_marks_etc:nnnnn {#4}{#5}{#6}{#7}{#8}
      \int_gset:Nn\c@secnumdepth{\l__head_saved_secnumdepth_tl}
  }
  \@nobreakfalse
  \global\@noskipsectrue
  \everypar{%
    \if@noskipsec
       \global\@noskipsecfalse
       {\setbox\z@\lastbox}
       \clubpenalty\@M
       \@svsechd
       \unskip
       \UseTaggingSocket{sec/title/split}
       \skip_horizontal:N \l__head_after_skip
    \else
      \clubpenalty \@clubpenalty
      \everypar{}%
    \fi
  }
  \l__head_final_code_tl
  \ignorespaces
}
\DeclareTemplateCode{headformat}{display}{6} % args: keys,prefix,number,title,subtitle,quotation
 {
  , heading-indent    = \l__head_heading_indent_dim
  , title-format      = \__head_title_format:n
  , prefix-number-sep = \l__head_prefix_number_sep_tl
  , number-title-sep  = \l__head_number_title_sep_tl
 }
 {
  \__head_show_arguments:nnnnnn {#1}{#2}{#3}{#4}{#5}{#6}
  \tl_if_empty:oF {#1} { \SetTemplateKeys{headformat}{display}{#1} }
  \group_begin:
  \UseTaggingSocket{sec/title/begin}{{\int_use:N\l__head_level_int}{#4}}
    \normalfont
    \interlinepenalty \@M
    \l__head_heading_decls_tl{}
    \bool_if:NTF \l__head_unnumbered_bool
      {
        \dim_compare:nNnTF  \l__head_heading_indent_dim < \c_zero_skip
          {
            \skip_horizontal:N \l__head_heading_indent_dim
            \MakeLinkTarget[\l__head_name_tl]{}
          }
          {
            \MakeLinkTarget[\l__head_name_tl]{}\skip_horizontal:N \l__head_heading_indent_dim
          }
      }
      {
        \dim_compare:nNnTF  \l__head_heading_indent_dim < \c_zero_skip
          {
            \skip_horizontal:N \l__head_heading_indent_dim
            \MakeLinkTarget{\l__head_name_tl}
          }
          {
            \MakeLinkTarget{\l__head_name_tl}\skip_horizontal:N \l__head_heading_indent_dim
          }
        \IfNoValueF{#2}
          {
            { \l__head_prefix_decls_tl #2 }
            \nobreak
            \skip_horizontal:n { \l__head_prefix_number_sep_tl }
          }
        \l__head_number_decls_tl
        #3
        \par\nobreak
        \skip_vertical:n { \l__head_number_title_sep_tl }
      }
    \l__head_title_decls_tl
    \__head_title_format:n {#4}
    \par
    \UseTaggingSocket{sec/title/end}
  \group_end:
 }
\DeclareTemplateCode{headformat}{hang}{6} % args: keys,prefix,number,title,subtitle,quotation
 {
  , heading-indent    = \l__head_heading_indent_dim
  , title-format      = \__head_title_format:n
  , prefix-number-sep = \l__head_prefix_number_sep_tl
  , number-title-sep  = \l__head_number_title_sep_tl
 }
 {
  \__head_show_arguments:nnnnnn {#1}{#2}{#3}{#4}{#5}{#6}
  \tl_if_empty:oF {#1} { \SetTemplateKeys{headformat}{hang}{#1} }
  \group_begin:
    \UseTaggingSocket{sec/title/init}{\int_use:N\l__head_level_int}
    \normalfont
    \interlinepenalty \@M
    \l__head_heading_decls_tl{}
    \bool_if:NTF \l__head_unnumbered_bool
      {
        \tl_set:Nn\l__head_tmpa_tl
         {
          \dim_compare:nNnTF  \l__head_heading_indent_dim < \c_zero_skip
            {
                \skip_horizontal:N \l__head_heading_indent_dim \MakeLinkTarget[\l__head_name_tl]{}
            }
            {
                \MakeLinkTarget[\l__head_name_tl]{}
                \skip_horizontal:N \l__head_heading_indent_dim
            }
         }
      }
      {
       \tl_set:Nn \l__head_tmpa_tl
        {
          \dim_compare:nNnTF  \l__head_heading_indent_dim < \c_zero_skip
              {
                \skip_horizontal:N \l__head_heading_indent_dim  \MakeLinkTarget{\l__head_name_tl}
              }
              {
                \MakeLinkTarget{\l__head_name_tl}\skip_horizontal:N \l__head_heading_indent_dim
              }
          \IfNoValueF{#2}
              {
                { \l__head_prefix_decls_tl #2 }
                \nobreak
                \skip_horizontal:n { \l__head_prefix_number_sep_tl }
              }
          { \l__head_number_decls_tl #3 }
          \skip_horizontal:n { \l__head_number_title_sep_tl }
        }
       }
     \UseTaggingSocket{sec/title/hang}
       {{\int_use:N\l__head_level_int}\l__head_unnumbered_bool{\l__head_tmpa_tl}{#4}}
       {
        \@hangfrom
          {
           \l__head_tmpa_tl
          }
       }
    \l__head_title_decls_tl
    \__head_title_format:n {#4}
    \par
  \group_end:
 }
\DeclareTemplateCode{headformat}{runin}{6} % args: keys,prefix,number,title,subtitle,quotation
 {
  , heading-indent    = \l__head_heading_indent_dim
  , title-format      = \__head_title_format:n
  , prefix-number-sep = \l__head_prefix_number_sep_tl
  , number-title-sep  = \l__head_number_title_sep_tl
 }
 {
  \__head_show_arguments:nnnnnn {#1}{#2}{#3}{#4}{#5}{#6}
  \tl_if_empty:oF {#1} { \SetTemplateKeys{headformat}{hang}{#1} }
