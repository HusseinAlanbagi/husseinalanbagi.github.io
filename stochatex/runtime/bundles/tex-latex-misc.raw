    \providecommand\addcontentslinebookmarkOff{}
    \RenewCommandCopy\addcontentslinebookmark\__hyp_addcontentsline_bookmark:nnn
    \renewcommand\addcontentslinebookmarkOff
     {
       \bool_if:NTF \l_pdfoutline_active_bool
        {
