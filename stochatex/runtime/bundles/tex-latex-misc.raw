\cs_new_protected:Npn \__tag_check_struct_forbidden_parent_child:nnn #1#2#3
 {
   \int_compare:nNnT {#1 } <0
     {
       \prop_get:cnN {g__tag_struct_#2_prop}{parentrole}\l__tag_get_parent_tmpc_tl
       \prop_get:cnN {g__tag_struct_#3_prop}{rolemap}\l__tag_get_child_tmpc_tl
       \msg_warning:nneeee
         { tag }
         {role-struct-parent-child-forbidden}
         { #2 }
         { #3 }
         {
           \exp_last_unbraced:No \use_ii:nn  { \l__tag_get_parent_tmpc_tl }
           :
           \exp_last_unbraced:No \use_i:nn  {\l__tag_get_parent_tmpc_tl }
         }
         {
           \exp_last_unbraced:No \use_ii:nn { \l__tag_get_child_tmpc_tl }
           :
           \exp_last_unbraced:No \use_i:nn { \l__tag_get_child_tmpc_tl }
         }
     }
 }
