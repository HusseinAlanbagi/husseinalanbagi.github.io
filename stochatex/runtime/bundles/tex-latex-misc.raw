\cs_new_protected:Npn \__pdf_backend_action:nnnnnnn #1#2#3#4#5#6#7
  {
    \tex_special:D
     {
       pdf:out~
       [\bool_if:nF{#3}{-}]~#1~
       <<
         /A<<\exp_not:n{#6}>>~
         /Title~(\exp_not:n{#7})~
         /F~#5~
         \tl_if_blank:nF { #4 }{/C~[#4]}
       >>
     }
  }
\cs_new_protected:Npn \__pdf_backend_goto:nnnnnnn #1#2#3#4#5#6#7
  {
    \tex_special:D
     {
       pdf:out~
       [\bool_if:nF{#3}{-}]~#1~
       <<
         /A
           <<
             /S/GoTo/D(\exp_not:n{#6})
             \tag_if_active:T
              {
                /SD~@pdf.SDest.#6
              }
           >>~
         /Title~(\exp_not:n{#7})~
         /F~#5~
         \tl_if_blank:nF { #4 }{/C~[#4]}
       >>
     }
  }
