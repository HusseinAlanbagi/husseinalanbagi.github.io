         }
     }
  }
\cs_generate_variant:Nn \pdfoutline_goto:nnn {nee}
\cs_new_protected:Npn \__pdfoutline_item:nnnn #1 #2 #3 #4
  {
    \int_gincr:N \g__pdfoutline_id_int
    \int_compare:nNnTF {#1}={0}
      {
        \intarray_gset:Nnn
          \g__pdfoutline_parent_id_intarray
          { \g__pdfoutline_id_int }
          { \g__pdfoutline_current_parent_id_tl }
        \intarray_gset:Nnn
          \g__pdfoutline_kid_count_intarray
          { \g__pdfoutline_current_parent_id_tl }
          { \intarray_item:Nn \g__pdfoutline_kid_count_intarray { \g__pdfoutline_current_parent_id_tl } + 1 }
       }
       {
         \int_compare:nNnTF {#1} > {0}
           {
             \int_gincr:N \g__pdfoutline_current_level_int
             \tl_gset:Ne \g__pdfoutline_current_parent_id_tl
               { \int_eval:n { \g__pdfoutline_id_int -1 } }
             \intarray_gset:Nnn
               \g__pdfoutline_parent_id_intarray
                { \g__pdfoutline_id_int }
                { \g__pdfoutline_current_parent_id_tl }
             \intarray_gset:Nnn
               \g__pdfoutline_kid_count_intarray
               { \g__pdfoutline_current_parent_id_tl }
               { 1 }
            }
           {
             \int_compare:nNnTF { \g__pdfoutline_current_level_int } = {1}
              {
                \tl_gset:Ne \g__pdfoutline_current_parent_id_tl {1}
              }
              {
                \int_step_inline:nn
                  { \int_min:nn { \int_abs:n {#1} } { \g__pdfoutline_current_level_int -1 } }
                  {
                    \tl_gset:Ne \g__pdfoutline_current_parent_id_tl
                      { \intarray_item:Nn \g__pdfoutline_parent_id_intarray { \g__pdfoutline_current_parent_id_tl } }
                    \int_gdecr:N \g__pdfoutline_current_level_int
                  }
              }
             \intarray_gset:Nnn
               \g__pdfoutline_parent_id_intarray
                { \g__pdfoutline_id_int }
                { \g__pdfoutline_current_parent_id_tl }
             \intarray_gset:Nnn
               \g__pdfoutline_kid_count_intarray
               { \g__pdfoutline_current_parent_id_tl }
               {
                 \intarray_item:Nn
                  \g__pdfoutline_kid_count_intarray
                  { \g__pdfoutline_current_parent_id_tl } + 1
               }
           }
       }
     \__pdfoutline_store:nnn {#2}{#3}{#4}
  }
\cs_new_protected:Npn \__pdfoutline_color_export_aux:wnnN [#1] #2 #3 #4
  {
     \color_export:nnnN {#1}{#2}{ space-sep-#3 }#4
  }
\cs_new_protected:Npn \__pdfoutline_color_export:nnN #1 #2 #3 %#1 color, #2 target model, #3 command
  {
    \tl_if_blank:nTF { #1 }
     { \tl_clear:N #3 }
     {
       \tl_if_head_eq_charcode:nNTF {#1} [ %]
        {
          \__pdfoutline_color_export_aux:wnnN #1 { #2 } #3
        }
        {
          \color_export:nnN { #1 } { space-sep-#2 } #3
        }
     }
  }
\cs_generate_variant:Nn \__pdfoutline_color_export:nnN {ee}
\cs_new_protected:Npn \__pdfoutline_store:nnn #1 #2 #3
  {
    \int_compare:nNnF { \g__pdfoutline_current_level_int } < { \l_pdfoutline_open_int }
      { \bool_set_false:N \l_pdfoutline_open_bool }
    \__pdfoutline_color_export:eeN {\l_pdfoutline_color_tl}{\l_pdfoutline_color_model_tl}\l__pdfoutline_tmpa_tl
    \tl_build_gput_right:Ne \g__pdfoutline_collect_build_tl
      {
        \exp_not:N \use:c { __pdf_backend_#3:nnnnnnn }
        % #1 level, #2 kid count, #3 open? #4 color, #5 flag, #6 action/destination, #7 title,
          {
            \int_use:N \g__pdfoutline_current_level_int
          }
          {
            \exp_not:N \intarray_item:Nn
              \exp_not:N \g__pdfoutline_kid_count_intarray
              { \int_use:N \g__pdfoutline_id_int }
          }
          {
            \bool_if:NTF\l_pdfoutline_open_bool {\exp_not:N \c_true_bool }{ \exp_not:N \c_false_bool}
          }
          {
            \l__pdfoutline_tmpa_tl
          }
          {
            \bitset_to_arabic:N \l_pdfoutline_F_bitset
          }
          {
            \exp_not:n {#1} % action/destination, or expand??
          }
          {
            \exp_not:n {#2} % title, or expand??
          }
       }
  }
\cs_new:Npn \pdfoutline_id_ref_last: {\int_use:N\g__pdfoutline_id_int}
\cs_new:Npn \pdfoutline_level_ref_last: {\int_use:N\g__pdfoutline_current_level_int}
