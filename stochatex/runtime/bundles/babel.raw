\def\bbl@nocaption@i#1#2{% 1: text to be printed 2: caption macro \langXname
  \global\@namedef{#2}{\textbf{?#1?}}%
  \@nameuse{#2}%
  \edef\bbl@tempa{#1}%
  \bbl@sreplace\bbl@tempa{name}{}%
  \bbl@sreplace\bbl@tempa{NAME}{}%
  \bbl@warning{%
    \@backslashchar#1 not set for '\languagename'. Please,\\%
