\IfBabelIntercharT{linebreak.basic}{%
  \bbl@input@classes
  \bbl@carg\bbl@add{extras\CurrentOption}%
    {\babel@savevariable\XeTeXinterchartokenstate
     \XeTeXinterchartokenstate\@ne}%
