index = [Α Β Γ Δ Ε Ζ Η Θ Ι Κ Λ Μ Ν Ξ Ο Π Ρ Σ Τ Υ Φ Χ Ψ Ω]
punctuation = [\\- ‐ ‑ – — , ; \\: ! . … \" « » ( ) \\[ \\] § @ * / \\\\ \\&]

[numbers]
