       \fi
    \or\ifnum\numexpr #1-10*\hebrew@num@trunc{#1}{10}>0 ע\else
         \ifnum#2>0 \ifnum#1=70 ע\BabelHebrewNumeralMarkerSingle
         \else\BabelHebrewNumeralMarkerFinal ע\fi\else ע\fi
