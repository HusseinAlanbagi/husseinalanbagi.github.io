    \or\ifnum\numexpr #1-10*\hebrew@num@trunc{#1}{10}>0 נ\else
         \ifnum#2>0 \ifnum#1>50 \BabelHebrewNumeralMarkerFinal\fi\fi
         \if #22ן\else נ\fi\ifnum#2>0 \ifnum#1=50 \BabelHebrewNumeralMarkerSingle\fi\fi
