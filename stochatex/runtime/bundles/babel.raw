    {default}{cjkideogram}%
    {\BabelCJKSpace}%
  \babelinterchar[label=linebreak.basic]{\CurrentOption}%
    {default}{cjkleftpunctuation}%
    {\BabelCJKSpace}%
  \babelinterchar[label=linebreak.basic]{\CurrentOption}%
    {default}{cjkrightpunctuation}%
    {\nobreak\BabelCJKSpace}%
