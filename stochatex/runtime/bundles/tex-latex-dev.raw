\def\pkgcls@parse@date@arg@#1=#2\@nil{%
  \pkgcls@targetdate
    \ifx\@nil#1\@nil
      \@parse@version0#2//00\@nil\relax
      \ifnum \pkgcls@targetdate=\z@
        \pkgcls@targetdate\@ne
        \def\pkgcls@innerdate{\maxdimen}%
