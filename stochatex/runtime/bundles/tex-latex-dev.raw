  \cs_gset_eq:NN \iow_shipout:Nn \iow_now:Nn
  \cs_gset_eq:NN \lua_shipout:n \lua_now:n
  \cs_gset:Npn \write {\tex_immediate:D \tex_write:D}
  \global\advance\c@page\m@ne
}
