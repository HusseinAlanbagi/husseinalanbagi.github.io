   \let\delayed@f@adjustment\@empty
   \UseHook{normalfont}%
   \selectfont}
\let\reset@font\normalfont
\def\set@current@meta@family {%
  \edef\rmdef@ult{\rmdefault}%
  \ifx\f@family\rmdef@ult
    \def\@currentmetafamily{rm}%
  \else
    \ifx\f@family\sfdef@ult
      \def\@currentmetafamily{sf}%
    \else
      \ifx\f@family\ttdef@ult
        \def\@currentmetafamily{tt}%
      \else
        \def\@currentmetafamily{??}%
      \fi
    \fi
  \fi
}
