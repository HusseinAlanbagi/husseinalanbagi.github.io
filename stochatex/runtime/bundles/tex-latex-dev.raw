\providecommand\plug[1]{\texttt{#1\DescribePlug[noprint]{#1}}}
\providecommand\DeclareDocElement[3][]{\@NewDocElement{#1}{#2}{#3}}
\DeclareDocElement[printtype=\textit{socket},idxtype=socket,idxgroup=Sockets]{Socket}{socketdecl}
\DeclareDocElement[printtype=\textit{hook},idxtype=hook,idxgroup=Hooks]{Hook}{hookdecl}
\DeclareDocElement[printtype=\textit{plug},idxtype=plug,idxgroup=Plugs]{Plug}{plugdecl}
\DeclareDocElement[envlike, idxtype=type, idxgroup=template types,
                    printtype=\textit{type}] {TemplateType}{templatetype}
\DeclareDocElement[envlike, idxtype=template, idxgroup=templates,
                    printtype=\textit{templ.}] {Template}{template}
\DeclareDocElement[envlike, idxtype=instance, idxgroup=instances,
                    printtype=\textit{inst.}] {Instance}{instance}
\DeclareDocElement[printtype=\textit{tag socket},idxtype=tag socket,
               idxgroup=Tagging Sockets]{TaggingSocket}{taggingsocketdecl}
\DeclareDocElement[printtype=\textit{tag plug},idxtype=tag plug,
               idxgroup=Tagging Plugs]{TaggingPlug}{taggingplugdecl}
\fi % end of \ifcsname NewDocElement\endcsname
