\IncludeInRelease{2026/06/01}%
                 {\@esphack}{chained space hacks}%
\def\@esphack{%
  \relax
  \ifhmode
    \spacefactor\@savsf
    \ifdim\@savsk>\z@
      \ifdim\lastskip=\z@
        \nobreak
        \hskip-1sp\relax\hskip1sp\relax
      \fi
      \ignorespaces
    \fi
  \else
    \ifvmode
      \if@nobreak\nobreak\else\if@noskipsec\nobreak\fi\fi
    \fi
  \fi
}%
\EndIncludeInRelease
\IncludeInRelease{2018/10/10}%
                 {\@esphack}{hyphenation and nobreak after space hack}%

\def\@esphack{%
