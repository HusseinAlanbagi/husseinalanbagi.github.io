\def\@removefromreset#1#2{%
  \@ifundefined{c@#2}\relax
  {\@ifundefined{alias@ctr@#1}{%
     \@ifundefined{alias@ctr@#2}{%
       \begingroup
         \expandafter\let\csname c@#1\endcsname\@removefromreset
         \def\@elt##1{%
           \expandafter\ifx\csname c@##1\endcsname\@removefromreset
           \else
             \noexpand\@elt{##1}%
           \fi}%
         \expandafter\xdef\csname cl@#2\endcsname
          {\csname cl@#2\endcsname}%
        \endgroup}%
       {\@latex@warning{Alias counters can not be removed from a reset.\MessageBreak
       Use '\@kernel@get@ctr@root{#2}' instead of '#2'.}}}
     {\@latex@warning{Alias counters can not be removed from a reset.\MessageBreak
       Use '\@kernel@get@ctr@root{#1}' instead of '#1'.}}}}
\EndIncludeInRelease
