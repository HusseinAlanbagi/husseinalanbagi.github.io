                  { \dim_compare_p:nNn \l__graphics_urx_dim = { -\c_max_dim } }
                  { \dim_compare_p:nNn \l__graphics_ury_dim = { -\c_max_dim } }
                  { \ior_map_break: }
              }
            \__graphics_bb_save:n {#1}
          }
        \ior_close:N \l__graphics_tmp_ior
      }
  }
