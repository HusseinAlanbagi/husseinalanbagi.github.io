  \addtocontents{#1}{\protect\contentsline{#2}{#3}{\thepage}{}%
                     \protected@file@percent}}
\DeclareExpandableDocumentCommand\@gobble@om{+o+m}{}
\DeclareExpandableDocumentCommand\@gobble@som{s+o+m}{}
