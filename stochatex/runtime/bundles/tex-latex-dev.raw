\multiputxy(-\value{fvmm},0){5}{\line(0,1){\value{frmm}}}

\addtoy{\value{mm}}
\multiput(-\value{mm},\value{y})(-\value{mm},0){25}%
          {\line(0,1){\value{tmm}}}

\addtoy{\value{frmm}}
