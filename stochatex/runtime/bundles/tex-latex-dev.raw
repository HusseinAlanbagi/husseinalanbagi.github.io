\newcommand\@amsthm@reset@ynthm
 {
  \def\@ynthm##1[##2]##3{%
  \ifx\relax##2\relax
    \def\@tempa{\@oparg{\@xthm{##1}{##3}}[]}%
  \else
    \@ifundefined{c@##2}{%
      \def\@tempa{\@nocounterr{##2}}%
    }{%
      \newcounteralias{##1}{##2}% UF
      \toks@{##3}%
      \@xp\xdef\csname##1\endcsname{%
        \@nx\@thm{%
          \let\@nx\thm@swap
            \if S\thm@swap\@nx\@firstoftwo\else\@nx\@gobble\fi
          \@xp\@nx\csname th@\the\thm@style\endcsname}%
            {##1}{\the\toks@}}% UF changed
      \let\@tempa\relax
    }%
  \fi
  \@tempa}
  \let\@amsthm@saved@ynthm\@ynthm
 }
\AddToHook{package/amsthm/after}[firstaid/aliascounter]
 {
   \@amsthm@reset@ynthm
   \AddToHook{package/cleveref/after}[firstaid/aliascounter]{\let\@ynthm\@amsthm@saved@ynthm}
 }
\AddToHook{class/amsart/after}[firstaid/aliascounter]
 {
   \@amsthm@reset@ynthm
   \AddToHook{package/cleveref/after}[firstaid/aliascounter]{\let\@ynthm\@amsthm@saved@ynthm}
 }
\AddToHook{class/amsbook/after}[firstaid/aliascounter]
 {
   \@amsthm@reset@ynthm
   \AddToHook{package/cleveref/after}{\let\@ynthm\@amsthm@saved@ynthm}
 }
\AddToHook{class/amsproc/after}[firstaid/aliascounter]
 {
   \@amsthm@reset@ynthm
   \AddToHook{package/cleveref/after}[firstaid/aliascounter]{\let\@ynthm\@amsthm@saved@ynthm}
 }
