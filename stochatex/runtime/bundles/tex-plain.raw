  \def\par{\leavevmode\endgraf}% don't skip empty lines
  \mft@nocats \obeyspaces \obeylines \tt}

% the percent sign in btex .. etex group is a comment character.
\def\mft@btex{\begingroup \mft@noc@ts \obeyspaces \tt}

