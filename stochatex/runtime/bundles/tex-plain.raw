\outer\def\mftbeginV#1{\5{#1}$\mftverbatimtex}
\outer\def\mftbeginB#1{\5{#1}$\mftbtex}
\def\mftend#1{$\5{#1}}

\outer\def\mftverbatimtex{\let\par=\endgraf \mft@verbatimtex \parskip=\z@
  \mft@finish}
\outer\def\mftbtex{\mft@btex \mft@finish}

