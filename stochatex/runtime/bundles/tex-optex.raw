        {} {\rm \bf \it \bi} {}
        {[GFSBodoni]}
        {\_def\_fontnamegen{[GFSBodoni\_currV]:script=latn;\_capsV\_fontfeatures}}

\_wlog{\_detokenize{%
Modifier:^^J
 \caps ...... Caps & Small caps (only \rm)^^J
}}

