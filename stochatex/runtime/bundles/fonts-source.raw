beginchar(oct"067",14u#,v_center(spread#+rule_thickness#+6u#)); 
adjust_fit(0,0); pickup rule.nib; lft x2=hround(1.5u); 
x3=x2; x1=hround(w-x2);   
top y2=h-3u; y2-y3=spread; y1=.5[y2,y3]; 
