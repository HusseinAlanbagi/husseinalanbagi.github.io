dish#:=.8/36pt#;          % amount erased at top or bottom of serifs
bracket#:=6/36pt#;          % vertical distance from serif base to tangent
jut#:=17/36pt#;               % protrusion of lowercase serifs
cap_jut#:=24/36pt#;          % protrusion of uppercase serifs
