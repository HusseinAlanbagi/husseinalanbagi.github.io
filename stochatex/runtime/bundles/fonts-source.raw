beginchar(oct"356",5u#,x_height#+acc_height#,0);
italcorr (x_height#+acc_height#)*slant-serif_fit#+.5stem#-2u#;
adjust_fit(serif_fit#+stem_shift#
   if monospace:+.25u#fi,serif_fit#-stem_shift#);
