font_size (gensize*pt#);
basedef                             (      8,      9,     10,     12);
gendef   [1/36pt#]( u#             )(     17,   18.9,     21,   24.7);
gendef   [1/36pt#]( width_adj#     )(      0,      0,      0,      0);
