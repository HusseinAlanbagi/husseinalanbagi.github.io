% Reported by Silas Brown, 4 April 2003, via Debian bug 184875.
% {\tt dvips -Ppdf} wants 8000$\,$dpi fonts, so define a mode for that.
mode_def dpdfezzz =                 %\[ dvips -Ppdf (8000dpi)
