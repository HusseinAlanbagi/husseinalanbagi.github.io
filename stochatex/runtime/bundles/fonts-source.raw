input logo8
% {\tt\catcode`\$=12 $Id: modes.mf,v 1.32 2026/01/03 18:54:07 karl Exp $ }
%%\font\tenlogosl=logosl10
%%\def\logofont{\ifdim\fontdimen1\font>0pt \tenlogosl\else\tenlogo\fi}
%%\def\MF{{\logofont META}\-{\logofont FONT}}
