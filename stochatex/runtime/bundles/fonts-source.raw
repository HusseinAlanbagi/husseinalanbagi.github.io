gendef   [1/36pt#]( body_height#   )(    200,    225,    250,    300);
gendef   [1/36pt#]( asc_height#    )(    176,    198,    220,    264);
gendef   [1/36pt#]( cap_height#    )(    176,    198,    220,    264);
