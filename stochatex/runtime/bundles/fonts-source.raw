gendef   [1/36pt#]( slab#          )(     19,     21,     22,     25);
gendef   [1/36pt#]( cap_bar#       )(     19,     21,     22,     25);
gendef   [1/36pt#]( cap_band#      )(     19,     21,     22,     25);
gendef   [1/36pt#]( cap_notch_cut# )(     22,     24,     25,     28);
