local v3 = 0

local imp_mt= {
  __mul = function(a,b)
    if b==imp then
		 v3 = v3 + 1
      tmp3[v3]=a
      return tmp3
    elseif a == tmp3 then
      local w3 =  _imp(tmp3[v3], b)
      v3 = v3 - 1
		return w3
    end
  end
}

setmetatable(tmp3, imp_mt)
setmetatable(imp, imp_mt)
_G.imp = imp

local function _iff(a, b)
  if a == b then return 1
    else return 0 end
end

local tmp4 = {}
local iff = {}
