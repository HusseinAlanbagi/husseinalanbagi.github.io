testringconvert(a, iring, "(12x^0)/(1x^0)", "ZZ(x)")
testringconvert(a, jring, "(12/1x^0)/(1/1x^0)", "QQ(x)")
testringconvert(a, kring, "2x^0", "Z/Z5[x]")
testringconvert(a, lring, "((12/1x^0)/(1/1x^0))y^0", "QQ(x)[y]")

