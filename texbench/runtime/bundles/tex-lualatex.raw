}

setmetatable(tmp5, xor_mt)
setmetatable(logxor, xor_mt)
_G.logxor = logxor

local function _nand(a, b)
  if a ==1 and b == 1 then return 0
    else return 1 end
end

local tmp6 = {}
local lognand = {}
local v6 = 0

local nand_mt= {
  __mul = function(a,b)
    if b==lognand then
		 v6 = v6 + 1 
      tmp6[v6]=a
