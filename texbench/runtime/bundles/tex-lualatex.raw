   \setlength\belowdisplayshortskip{3pt plus 2pt minus 1 pt}%
   \def\@listi{\leftmargin\leftmargini%
               \topsep 4\p@ \@plus2\p@ \@minus2\p@%
               \parsep 2\p@ \@plus\p@ \@minus\p@%
               \itemsep \parsep}%
 \setlength \belowdisplayskip {\abovedisplayskip}%
 }%
