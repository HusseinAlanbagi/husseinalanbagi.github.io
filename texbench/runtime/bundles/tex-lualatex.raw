_G.KKLuaVerb = KKV% KKluaverb.sty
% Copyright (c) 2026 Kosei Kawaguchi
% Released under the MIT License (see LICENSE.md for details)
% -----
% This file is based on 'bxrawstr.lua' by Takayuki YATO (aka. "ZR").
