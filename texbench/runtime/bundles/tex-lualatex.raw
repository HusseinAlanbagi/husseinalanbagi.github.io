%------IntÃ©grer
\NewDocumentCommand\sympyintegr{ s D<>{Simplif} m O{x} m m }{%
	\StrSubstitute{#3}{/}{*S.One/}[\argtmp]%
	\IfBooleanTF{#1}%*=frit, no*=fr
		{%
			\IfStrEq{#2}{Simplif}%
				{%
					\py{patch_oo(latex_frit_simpl(integrate(\argtmp,(#4,#5,#6))))}%
				}%
				{%
