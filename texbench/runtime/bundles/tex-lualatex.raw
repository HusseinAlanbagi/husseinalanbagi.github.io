                            Integer(4),
                            Integer(5),
                            Integer(6)})

starttest("expression construction")
testeq(a, "3 + 5")
testeq(b, "(13 + 12) * -4")
testeq(c, "x / y")
testeq(d, "(4 + -3) / y")
testeq(e, "3 + 4 + 5 + 6")
endtest()

