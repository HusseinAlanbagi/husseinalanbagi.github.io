              { tcolorbox .code:n = \__piton_error:n { library~breakable~not~loaded } }
          }
      }
      {
        \keys_define:nn { PitonOptions }
          { tcolorbox .code:n = \__piton_error:n { tcolorbox~not~loaded } }
      }
  }
