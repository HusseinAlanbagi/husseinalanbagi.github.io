        \node[anchor=east, text=mt] at (4,-8.5) {\fontsize{15}{15}\selectfont \textit{#1}};
        \node[anchor=east, text=black] at (4,-9.5) {\fontsize{15}{15}\selectfont {#2}};
        \node[anchor=east, text=black] at (4,-10) {\fontsize{11}{11}\selectfont \textit{#3}};
        \node[anchor=center] at (1,-7) {\includegraphics[width=#6]{#5}};
        \clip
            (0, 4) -- (3.48, 2) -- (3.48, -2) -- 
