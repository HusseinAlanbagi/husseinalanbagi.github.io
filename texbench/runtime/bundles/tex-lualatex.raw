\newcommand{\fakebold}[1]{\textpdfrender{TextRenderingMode=FillStroke,LineWidth=0.5pt}{#1}}
\usetikzlibrary{shadows.blur}
\usetikzlibrary{patterns}

%\geometry{includehead,top=1.5cm,bottom=2cm}
