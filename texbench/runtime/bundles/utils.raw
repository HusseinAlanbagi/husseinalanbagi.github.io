\def\etb@lst@q@end{\etb@lst@q@end}

\def\etb@defparser@arg#1#2{%
  \ifblank{#2}{\long\def#1##1##2{%
    \etb@lst@@notoken@arg{##1}##2\etb@lst@q@end&}}
