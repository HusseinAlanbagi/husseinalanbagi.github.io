\cs_new_protected:Npn \__box_vcenter_calc:n #1
  {
    \dim_set:Nn \l__box_delta_dim
      { \box_ht:N \l__box_tmp_box + \box_dp:N \l__box_tmp_box }
    \tex_ht:D \l__box_tmp_box \__box_dim_eval:n
      {
        \__box_dim_eval:n
          { \tex_ifodd:D \l__box_delta_dim 1sp + \tex_fi:D \l__box_delta_dim }
        / 2
        + (#1)
      }
    \tex_dp:D \l__box_tmp_box \__box_dim_eval:n
      { \l__box_delta_dim - \box_ht:N \l__box_tmp_box }
    \box_use_drop:N \l__box_tmp_box
  }
