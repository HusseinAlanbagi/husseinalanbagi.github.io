  \HyColor@HyperrefColor{#1}\@linkcolor
  \HyColor@HyperrefColor{#1}\@anchorcolor
  \HyColor@HyperrefColor{#1}\@citecolor
  \HyColor@HyperrefColor{#1}\@filecolor
