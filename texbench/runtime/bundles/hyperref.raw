\edef\Hy@pdfminorversion{\pdfvariable minorversion}%
\edef\Hy@pdfmajorversion{\pdfvariable majorversion}%

\ifHy@ocgcolorlinks
    \ifnum\Hy@pdfmajorminor@version<105 %
      \kvsetkeys{Hyp}{pdfversion=1.5}%
    \fi
  \fi
