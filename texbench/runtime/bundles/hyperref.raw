      \@ifundefined{theHpage}{%
        \protected@edef\Hy@TheSlideOptionalPage{%
          \Hy@SlidesFormatOptionalPage{\thepage}%
        }%
      }{%
        \protected@edef\Hy@TheSlideOptionalPage{%
          \Hy@SlidesFormatOptionalPage{\theHpage}%
