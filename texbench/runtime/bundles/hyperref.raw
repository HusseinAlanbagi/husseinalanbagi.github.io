\@ifclassloaded{slides}{%
  \def\Hy@SlidesFormatOptionalPage#1{(#1)}%
  \def\Hy@PageAnchorSlidesPlain{%
    \advance\c@page\@ne
    \xdef\@currentHpage{page.\the\c@slide.\the\c@overlay.\the\c@note%
        \ifnum\c@page=\@ne
        \else
          .\the\c@page
        \fi}%
    \edef\Hy@TempPageAnchor{%
      \noexpand\hyper@@anchor{%
        \@currentHpage
      }%
    }%
