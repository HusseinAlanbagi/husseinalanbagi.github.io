  \ifx\Hy@setbreaklinks\@gobble
    \ifHy@breaklinks
      \Hy@WarningNoLine{%
        You have enabled option `breaklinks'.\MessageBreak
        But driver `\Hy@driver.def' does not support this.\MessageBreak
        Expect trouble with the link areas of broken links%
      }%
    \fi
  \fi
}
