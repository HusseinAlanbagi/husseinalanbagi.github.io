  \@ifnextchar[{\Hy@babelnormalise\label@hyperref}\@hyperref
}
\def\Hy@babelnormalise#1[#2]{%
  \begingroup
    \Hy@safe@activestrue
    \let\protect\@unexpandable@protect
    \edef\Hy@tempa{%
      \endgroup
      \noexpand#1[{#2}]%
    }%
