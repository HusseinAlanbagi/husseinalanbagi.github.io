  }
\gates@action{return9}#1#2#3#4#5#6#7#8#9{%
  \gates@return_passnine{{#1}{#2}{#3}{#4}{#5}{#6}{#7}{#8}{#9}}%
  }
\long\def\gates@return_pass#1#2\gates@execute_stoploop#3#4{%
