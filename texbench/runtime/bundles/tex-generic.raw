                {\yax@ifvalue_getvalue{#1}{#2}}
                {\yax@ifattribute_if{}{\passexpandedcs{\ifstring{#3}}}{#1}{#2}}%
  }
\def\yax@ifvaluenometa_getvalue#1#2#3 {%
  \ifemptystring{#3}
                {\yax@ifvaluenometa_getvalue{#1}{#2}}
                {\ifcs{yax@#1:#2}{\passexpandedcs{\ifstring{#3}}{yax@#1:#2}}\secondoftwo}%
  }
%
