\def\SE@@from@general#1#2{%
  \ifx#1\relax
    \let\SE@next\relax
  \else
    \ifnum"#1<8 % "#1#2<128
      \SE@ResultAdd{00#1#2}%
    \else
      \SE@MapConvertFrom\SE@encoding{#1#2}%
    \fi
  \fi
