\@namedef{Gin@rule@.jpeg}#1{{jpg}{.jpeg}{#1}}
\@namedef{Gin@rule@.JPG}#1{{jpg}{.JPG}{#1}}
\@namedef{Gin@rule@.JPEG}#1{{jpg}{.JPEG}{#1}}
\@namedef{Gin@rule@.jb2}#1{{jbig2}{.jb2}{#1}}%
\@namedef{Gin@rule@.jbig2}#1{{jbig2}{.jbig2}{#1}}%
\@namedef{Gin@rule@.png}#1{{png}{.png}{#1}}
