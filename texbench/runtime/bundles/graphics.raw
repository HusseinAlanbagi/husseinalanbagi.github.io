  \let\KV@Gin@bburx\KV@Gin@bbllx
  \let\KV@Gin@bbury\KV@Gin@bbllx
  \let\KV@Gin@natwidth\KV@Gin@bbllx
  \let\KV@Gin@natheight\KV@Gin@bbllx
